[Unit]
Description=SHMAX boot orchestration (wait for bind address, ensure published port, host readiness)
Documentation=https://github.com/SHMAX-Project/SHMAX
# network-online.target alone does NOT guarantee the configured
# bind address exists — the boot script verifies it explicitly.
After=docker.service network-online.target shmax-hostd.service
Wants=network-online.target
Requires=docker.service shmax-hostd.service

StartLimitIntervalSec=0

[Service]
Type=oneshot
# Bounded wait + retry with systemd backoff; never a rapid loop.
ExecStart=/opt/shmax/boot/shmax-boot.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
