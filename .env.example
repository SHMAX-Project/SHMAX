# ============================================================
# SHMAX example environment file
# Copy to `.env` for local development only.
# DO NOT commit real secrets.
# Production secrets live in /var/lib/shmax/secrets
# ============================================================

# --- Network ---
SHMAX_HOST=0.0.0.0
SHMAX_PORT=8787

# --- Persistent data root ---
# Production: /var/lib/shmax
# Local dev (macOS): SHMAX_DATA_DIR=./.dev-data
SHMAX_DATA_DIR=/var/lib/shmax

# --- Logging ---
SHMAX_LOG_LEVEL=INFO

# --- Future: secrets (will be moved to /var/lib/shmax/secrets) ---
# SHMAX_MAX_TOKEN=
# SHMAX_TG_BOT_TOKEN=
# SHMAX_TG_API_ID=
# SHMAX_TG_API_HASH=
